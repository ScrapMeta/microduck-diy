# Copied to /boot/microduck.env on the robot (optional).
# Used by microduck-firstboot.service after Wi-Fi works.

# GitHub token while pollen-robotics/microduck is private (contents:read).
DUCK_TOKEN=

# Branch or tag provision scripts + release resolve against.
DUCK_REF=main

# Robot display name (optional; empty → duck-<soc-serial>).
DUCK_NAME=

# 1 = set BlueZ Privacy=device (boards that cannot bond a pad at all).
DUCK_WEIRD_BLE=

# 1 = robotctl pad pair pauses btd (common on Zero 3W).
DUCK_PAUSE_BTD=1

# 0 = skip GStreamer / rkaiq during firstboot provision.
DUCK_GSTREAMER=1
DUCK_RKAIQ=1
