.DS_Store
Thumbs.db
*.zip
__pycache__/
.venv/

# Wiki large binaries (keep markdown; download zips locally as needed)
wiki/raw/assets/microduck-releases/*.zip
wiki/raw/assets/press-kit/

# Firmware build
imu_to_dxl/firmware/build/

# EDA local backups / exports
imu_to_dxl/hardware/*_backup/
imu_to_dxl/hardware/*.epro2

# Large local print profile (keep other cad/*.3mf)
cad/microduck_rl_assembly_a2l.3mf

# Seed image artifacts (keep scripts/overlay; do not commit images)
image/out/
image/**/*.img
image/**/*.img.xz
image/**/*.sha256

# Local scratch / vendor tool downloads (never commit)
# `tmp/` was merged into `temp/` on 2026-09-16 when the workspace root became this worktree;
# a new `tmp/` appeared since (the portability blueprint lived there) - keep both ignored.
temp/
tmp/
res/

# Read-only reference clones. Local reference only - never deliverables, never committed.
# NOTE: `git clean -x` DELETES ignored directories and would wipe every clone here.
# Use `git clean -fd` (no -x) in this repository.
refs/

# Owned sibling repo. Ignored like the clones, but it IS ours (we have push) - a deliverable,
# not a read-only reference. It keeps its own .git and is pushed separately. See governance 10.
microduck_ros2/

# Local VMs, virtualenvs, scratch
vms/
.tmp/
.venv-cad/
