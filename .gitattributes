# Shell scripts are executed on Linux / WSL2 (image build + board firstboot).
# Force LF in the repo and in the working tree so CRLF never lands in a script.
*.sh text eol=lf
image/overlay/usr/local/sbin/* text eol=lf
image/overlay/etc/systemd/system/* text eol=lf
# Bench scripts run on Linux / the Zero as well as on the Windows host.
*.py text eol=lf
